{
  "manifest_version": 3,
  "name": "Eloquix - LinkedIn AI Comment Generator",
  "version": "1.0.0",
  "description": "Generate premium, context-aware comments for LinkedIn posts using Eloquix Backend Server API.",
  "permissions": [
    "storage",
    "activeTab",
    "identity"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*"
  ],
  "oauth2": {
    "client_id": "523401799544-94cgm4rc47ejg5u03m9cttch1g44c330.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.linkedin.com/*"],
      "js": ["content/content.js"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
